# Visual Studio 2015 user specific files
.vs/

# VS Code specific files
.vscode/
*.code-workspace

# VS Code settings and extensions
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json

# VS Code user specific
*.vscodeignore

# Compiled Python files (for VS Code Python extensions)
__pycache__/
*.py[cod]

# VS Code browsing cache
*.db
*.db-shm
*.db-wal

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# AI 工具本地配置（仅本机）
.claude/settings.local.json
.claude/*.local.*

# 第三方游戏解包资产（仅本地参考，不入库）
/Content/BlackMythWukong/
/Content/Mesh/

# 外部文档导出（非项目文件）
qqdoc.html
qqdoc整理.md
